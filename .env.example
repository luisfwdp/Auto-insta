# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com
# Set to true so an empty or missing ALLOWED_EMAILS locks sign-in instead of
# opening it. Recommended for every public deployment.
# ALLOWED_EMAILS_REQUIRED=true

# Optional: who runs this instance. Only these people see instance-wide
# diagnostics (worker alerts, events not tied to a workspace). Unset, nobody
# sees them, only their own workspace's events.
# OPERATOR_EMAILS=you@example.com

# Optional: feature flags, see lib/feature-flags.ts and docs/feature-flags.md.
# Comma separated flag names; a leading "-" turns a default-on flag off.
# Leave unset in production to keep the stable defaults.
# FEATURE_FLAGS=newDesign,workspaceSwitcher

# Local MCP transport. The first delivery is intentionally loopback-only and
# must not be exposed publicly before OAuth and workspace authorization land.
# PINGCHAT_MCP_PORT=3333
# Workspace bound to this local MCP process. Tools never accept workspace IDs
# from the model; the operator selects one before starting the server.
# PINGCHAT_MCP_WORKSPACE_ID=replace-with-workspace-id

# Meta / Instagram
META_GRAPH_API_VERSION=v26.0
# New Meta apps use Unified Login. Leave unset for an existing legacy
# Instagram Login app.
INSTAGRAM_LOGIN_MODE=unified
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_CONFIG_ID=your-facebook-login-for-business-config-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
